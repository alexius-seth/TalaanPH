datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum TransactionType {
  CREDIT_PURCHASE
  PAYMENT
  ADJUSTMENT
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum ReminderStatus {
  PENDING
  SETTLED
  REMINDED
}

model Customer {
  id           String            @id @default(uuid()) @db.Uuid
  firstName    String            @map("first_name")
  lastName     String            @map("last_name")
  nickname     String
  phoneNumber  String            @map("phone_number")
  creditLimit  Decimal           @default(0.00) @map("credit_limit") @db.Decimal(12, 2)
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  accounts     Account[]
  reminders    PaymentReminder[]

  @@index([phoneNumber])
  @@index([nickname])
  @@map("customers")
}

model Account {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique
  type        AccountType
  customerId  String?       @map("customer_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")

  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  entries     LedgerEntry[]

  @@index([customerId])
  @@map("accounts")
}

model Transaction {
  id              String            @id @default(uuid()) @db.Uuid
  referenceNumber String            @unique @map("reference_number")
  type            TransactionType
  description     String?
  dueDate         DateTime?         @map("due_date")
  createdAt       DateTime          @default(now()) @map("created_at")

  entries         LedgerEntry[]
  items           TransactionItem[]
  reminders       PaymentReminder[]

  @@index([createdAt])
  @@index([dueDate])
  @@map("transactions")
}

model LedgerEntry {
  id            String         @id @default(uuid()) @db.Uuid
  transactionId String         @map("transaction_id") @db.Uuid
  accountId     String         @map("account_id") @db.Uuid
  amount        Decimal        @db.Decimal(12, 2)
  direction     EntryDirection
  createdAt     DateTime       @default(now()) @map("created_at")

  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId])
  @@map("ledger_entries")
}

model TransactionItem {
  id            String      @id @default(uuid()) @db.Uuid
  transactionId String      @map("transaction_id") @db.Uuid
  productId     String?     @map("product_id") @db.Uuid
  itemName      String      @map("item_name")
  quantity      Decimal     @default(1.00) @db.Decimal(10, 2)
  unitPrice     Decimal     @map("unit_price") @db.Decimal(12, 2)
  totalPrice    Decimal     @map("total_price") @db.Decimal(12, 2)

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([productId])
  @@map("transaction_items")
}

model PaymentReminder {
  id            String         @id @default(uuid()) @db.Uuid
  customerId    String         @map("customer_id") @db.Uuid
  transactionId String         @map("transaction_id") @db.Uuid
  dueDate       DateTime       @map("due_date")
  status        ReminderStatus @default(PENDING)
  remindedAt    DateTime?      @map("reminded_at")
  createdAt     DateTime       @default(now()) @map("created_at")

  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([dueDate, status])
  @@map("payment_reminders")
}

model Product {
  id                String               @id @default(uuid()) @db.Uuid
  name              String
  category          String
  baseUnit          String               @map("base_unit")
  currentStock      Decimal              @default(0.00) @map("current_stock") @db.Decimal(10, 2)
  lowStockThreshold Decimal              @default(5.00) @map("low_stock_threshold") @db.Decimal(10, 2)
  costPerBaseUnit   Decimal              @default(0.00) @map("cost_per_base_unit") @db.Decimal(12, 2)
  retailPrice       Decimal              @map("retail_price") @db.Decimal(12, 2)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  packageUnits      ProductPackageUnit[]

  @@index([category])
  @@index([name])
  @@map("products")
}

model ProductPackageUnit {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  unitName    String   @map("unit_name")
  multiplier  Decimal  @db.Decimal(10, 2)
  packageCost Decimal  @map("package_cost") @db.Decimal(12, 2)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_package_units")
}

model ProcessedSyncEvent {
  id          String    @id @db.Uuid
  action      String
  processedAt DateTime  @default(now()) @map("processed_at")

  @@map("processed_sync_events")
}
